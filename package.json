{
  "name": "llmos-schema-toolchain",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "schema:generate": "buf generate && node tools/normalize-generated-schema.mjs",
    "schema:check-generated": "npm run schema:generate && node tools/check-generated-schema.mjs",
    "schema:lint": "buf lint && buf format -d --exit-code",
    "schema:test:typescript": "tsx tests/conformance/schema/envelope.ts",
    "schema:typecheck": "tsc",
    "ipc:test:typescript": "tsx tests/conformance/ipc/client.ts",
    "directory:test:typescript": "tsx tests/conformance/ipc/directory_chain.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.13.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.72.0",
    "@types/node": "26.1.2",
    "tsx": "4.20.6",
    "typescript": "7.0.2"
  }
}

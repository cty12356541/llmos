{
  "name": "llmos-schema-toolchain",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "schema:generate": "buf generate && node tools/normalize-generated-schema.mjs",
    "schema:check-generated": "npm run schema:generate && node tools/check-generated-schema.mjs",
    "schema:lint": "buf lint && buf format -d --exit-code",
    "schema:test:typescript": "tsx tests/conformance/schema/envelope.ts",
    "schema:typecheck": "tsc",
    "ipc:test:typescript": "tsx tests/conformance/ipc/client.ts",
    "directory:test:typescript": "tsx tests/conformance/ipc/directory_chain.ts",
    "takeover-control:test:typescript": "tsx tests/conformance/ipc/takeover_control.ts",
    "takeover-control:long-soak:typescript": "tsx tests/conformance/ipc/takeover_control_long_soak.ts",
    "takeover-control:external-crash:typescript": "tsx tests/conformance/ipc/takeover_control_external_crash.ts",
    "wait-control:test:typescript": "tsx tests/conformance/ipc/wait_control.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.14.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.72.0",
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}

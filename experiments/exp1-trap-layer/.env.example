# ===== exp1-trap-layer 配置示例 =====
# 复制为 .env 后填写。.env 已在 .gitignore 中，绝不提交。

# --- 真实 provider（OpenAI 兼容转发服务）---
# 三项都配置且 MOCK_LLM=false 时走真实 provider；否则一律走 mock
LLM_BASE_URL=https://your-openai-compatible-endpoint.example.com/v1
LLM_API_KEY=sk-your-real-provider-key-here
LLM_MODEL=your-model-name

# --- mock 开关 ---
# true：强制使用进程内 mock provider（离线，全部测试/基准用此模式）
# false：使用上面的真实 provider
MOCK_LLM=true

# --- mock 行为 ---
MOCK_TOKENS_PER_SECOND=100000
MOCK_LATENCY_MS=0

# --- WAL ---
WAL_PATH=results/wal/trap-layer.wal.jsonl
WAL_BATCH_SIZE=256
WAL_FLUSH_INTERVAL_MS=50

# --- 代理监听 ---
PROXY_HOST=127.0.0.1
PROXY_PORT=8400

# --- admin 接口保护（可选；设置后 /admin/* 需要 X-Admin-Token 头）---
# ADMIN_TOKEN=change-me

# Driver negotiation profile (DRV-NEGO-001) for mcp-bridge-driver v1.0.0.
negotiation-mode = fail-closed-intersection
propose-version = 2025-03-26
accept-versions = 2025-03-26, 2024-11-05
disconnect-on-mismatch = true
tools-capability-required = true
transport = stdio-newline-delimited-jsonrpc
max-frame-bytes = 1048576

# nlos-certify sidecar directives for openai-compat-driver v1.0.0 (W80-E6B).
publisher-id = nlos.market.openai-gateway-works
application-id = nlos.market.openai-gateway-works.openai-compat-driver
surface-profile = application-platform
network-policy = egress-declared
egress-allow = https://llm-gateway.openai-compatible.example
sabi-service = import SERVICE_DIRECTORY feature=provider-register,health-watch
sabi-service = import RESOURCE_ESCROW feature=quota-hold,escrow-settle
sabi-service = import OBSERVABILITY feature=health-probe
idempotency-passthrough = * 128-bit

{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "TodoWrite|Agent|Task",
        "hooks": [
          {"type": "command",
           "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/record_event.py\" || true"}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command",
           "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/record_event.py\" || true"}
        ]
      }
    ]
  }
}
